{
  "appId": "com.aleph23.characardcreator",
  "productName": "CharaCardCreator",
  "buildVersion": "0.4.0",
  "directories": {
    "buildResources": "res/**/*",
    "output": "build-electron"
  },
  "files": [
    "package.json",
    {
      "from": "dist",
      "to": "dist",
      "filter": ["**/*"]
    },
    {
      "from": "electron",
      "to": "electron",
      "filter": ["**/*"]
    }
  ],
  "extraResources": [
    {
      "from": "public",
      "to": "public"
    }
  ],
  "mac": {
    "category": "public.app-category.games",
    "target": "dmg",
    "icon": "res/pencilicon.icns"
  },
  "win": {
    "target": "portable",
    "forceCodeSigning": false,
    "icon": "res/pencilicon.ico"
  },
  "linux": {
    "target": ["appimage", "deb"],
    "category": "Entertainment;Game;"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
